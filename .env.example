APP_NAME=Euflorea
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://euflorea.test

LOG_STACK=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=euflorea
DB_USERNAME=root
DB_PASSWORD=admin

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Serve Vite over HTTPS with the lerd certificate (avoids mixed content on https://euflorea.test)
VITE_DEV_SERVER_KEY=
VITE_DEV_SERVER_CERT=
INERTIA_SSR_ENABLED=false

RAPIDLOGIN_ENABLED=true
RAPIDLOGIN_HOME_ROUTE_NAME=dashboard

SITE_INSTAGRAM_URL=https://www.instagram.com/euflorea_/
SITE_FACEBOOK_URL=

SITE_CONTACT_RECIPIENT=
SITE_CONTACT_SEND_CONFIRMATION=false

GDPR_OPERATOR_NAME=
GDPR_OPERATOR_ADDRESS=
GDPR_OPERATOR_COMPANY_ID=
GDPR_OPERATOR_EMAIL=
