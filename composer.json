{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nebstersk/laravel-template",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.36",
        "laravel/framework": "^13.0",
        "laravel/head": "^0.2.2",
        "laravel/wayfinder": "^0.1.14",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-typescript-transformer": "^3.2"
    },
    "require-dev": {
        "andreapollastri/checkpoint": "^1.1",
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.7",
        "ekino/phpstan-banned-code": "^3.2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "*",
        "laravel/boost": "^2.5",
        "laravel/pint": "^1.25",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "veltisan/rapidlogin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:models -WR --no-interaction --silent",
            "vendor/bin/pint --silent",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "models": [
            "@php artisan ide-helper:models -WR --no-interaction"
        ],
        "larastan": [
            "vendor/bin/phpstan analyse"
        ],
        "pint": [
            "vendor/bin/pint"
        ],
        "resetup": [
            "@composer install --ansi",
            "npm install",
            "@php artisan migrate:fresh --seed --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
